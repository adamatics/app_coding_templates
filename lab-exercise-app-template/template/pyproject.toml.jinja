[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ exercise_title }} — a CPDSE student lab-exercise app"
requires-python = ">=3.11"
authors = [{ name = "{{ host_institution }}", email = "{{ contact_email }}" }]
dependencies = [
    "fastapi>=0.110",
    "uvicorn[standard]>=0.27",
    "sqlalchemy>=2.0",
    "pydantic>=2.6",
    "itsdangerous>=2.1",
    "pandas>=2.0",
    "pyarrow>=14",
]

[project.optional-dependencies]
dev = [
    "pytest>=8",
    "httpx>=0.27",
    "ruff>=0.6",
]

# The backend package `app` lives under backend/; the exercise seam is a top-level
# `exercise` package at the app root. This mapping lets `pip install .` pull the
# dependencies above (used by the Containerfile) despite the two source roots.
[tool.setuptools]
packages = ["app", "app.routers", "exercise"]

[tool.setuptools.package-dir]
"" = "backend"
exercise = "exercise"

[tool.pytest.ini_options]
# Make `app.*` (under backend/) and `exercise.*` (at root) importable in tests
# without installing the project.
pythonpath = ["backend", "."]
testpaths = ["backend/tests"]
