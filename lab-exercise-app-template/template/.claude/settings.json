{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/chassis_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(backend/app/**)",
      "Write(backend/app/**)",
      "MultiEdit(backend/app/**)",
      "Edit(frontend/src/App.tsx)",
      "Write(frontend/src/App.tsx)",
      "MultiEdit(frontend/src/App.tsx)",
      "Edit(frontend/src/main.tsx)",
      "Write(frontend/src/main.tsx)",
      "MultiEdit(frontend/src/main.tsx)",
      "Edit(frontend/src/api.ts)",
      "Write(frontend/src/api.ts)",
      "MultiEdit(frontend/src/api.ts)",
      "Edit(frontend/src/metaContext.ts)",
      "Write(frontend/src/metaContext.ts)",
      "MultiEdit(frontend/src/metaContext.ts)",
      "Edit(frontend/src/global.d.ts)",
      "Write(frontend/src/global.d.ts)",
      "MultiEdit(frontend/src/global.d.ts)",
      "Edit(frontend/src/ui.css)",
      "Write(frontend/src/ui.css)",
      "MultiEdit(frontend/src/ui.css)",
      "Edit(frontend/src/lib/**)",
      "Write(frontend/src/lib/**)",
      "MultiEdit(frontend/src/lib/**)",
      "Edit(frontend/src/components/**)",
      "Write(frontend/src/components/**)",
      "MultiEdit(frontend/src/components/**)",
      "Edit(frontend/src/pages/**)",
      "Write(frontend/src/pages/**)",
      "MultiEdit(frontend/src/pages/**)",
      "Edit(frontend/src/assets/**)",
      "Write(frontend/src/assets/**)",
      "MultiEdit(frontend/src/assets/**)",
      "Edit(frontend/vite.config.ts)",
      "Write(frontend/vite.config.ts)",
      "MultiEdit(frontend/vite.config.ts)",
      "Edit(frontend/tsconfig.json)",
      "Write(frontend/tsconfig.json)",
      "MultiEdit(frontend/tsconfig.json)",
      "Edit(frontend/index.html)",
      "Write(frontend/index.html)",
      "MultiEdit(frontend/index.html)",
      "Edit(frontend/scripts/**)",
      "Write(frontend/scripts/**)",
      "MultiEdit(frontend/scripts/**)",
      "Edit(.adalab/app.json)",
      "Write(.adalab/app.json)",
      "MultiEdit(.adalab/app.json)",
      "Edit(.adalab/project.json)",
      "Write(.adalab/project.json)",
      "MultiEdit(.adalab/project.json)",
      "Edit(.adalab/card.json)",
