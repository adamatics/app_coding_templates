# CHASSIS. Single-stage, single-process Streamlit app (Addendum B §B1/§B8).
# The Node/Vite build stage is gone with the React frontend.
#
#   podman build -t my-app .          # or: docker build -f Containerfile -t my-app .
#   podman run -p 8000:8000 -v ./lab-data:/asv-mnt/lab-data \
#     -e COURSE_PASSWORD=lab2026 -e ADMIN_PASSWORD=x my-app
#
# A writable volume MUST be mounted at $DATA_DIR (/asv-mnt/lab-data): the app refuses to
# start otherwise, so student data is never written to disposable container-local storage.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DATA_DIR=/asv-mnt/lab-data \
    APP_PORT=8000 \
    DEMO_MODE=false

# Serve at the container root. AdaLab's default `stripped_prefix: true` removes the
# /apps/<app_url> prefix before forwarding, and Streamlit emits RELATIVE asset URLs
# (./static/..., ./_stcore/stream), so the browser resolves them against the prefixed page
# and the proxy strips them again on the way in. Both the page and the websocket work.
#
# Serving at the root also keeps the extension's Test step working: it probes "/" on the
# container and expects 2xx. With --server.baseUrlPath set, "/" is a 404 and Test fails.
#
# Escape hatch: if your platform does NOT strip the prefix, set BASE_URL_PATH to the prefix
# (e.g. "apps/<app_url>") AND set stripped_prefix:false in .adalab/app.json. Never mix the
# two — a prefix-aware app behind a stripping proxy 404s on every asset.
ENV BASE_URL_PATH=""

WORKDIR /app

# uv for fast, reproducible installs (§B8).
RUN pip install --no-cache-dir uv==0.4.27

# Dependencies first (better layer caching): install from pyproject without the project itself.
COPY pyproject.toml ./
RUN uv pip install --system --no-cache -r pyproject.toml

COPY core/ ./core/
COPY ui/ ./ui/
COPY exercise/ ./exercise/
COPY assets/ ./assets/
COPY .streamlit/ ./.streamlit/
COPY app.py ./

EXPOSE 8000

# Preflight FIRST (fail-loud storage, §A3): if the volume is missing or unwritable the
# process exits non-zero and Streamlit is never started — the container must not serve an app
# whose writes all fail. Then exec streamlit.
#
# The baseUrlPath flag is added only when BASE_URL_PATH is non-empty (see the ENV above);
# by default the app serves at the root, which is what both the AdaLab proxy (stripping)
# and the extension's Test probe expect.
CMD ["sh", "-c", "python -m core.preflight && exec streamlit run app.py \
  --server.port=${APP_PORT:-8000} \
  --server.address=0.0.0.0 \
  --server.headless=true \
  ${BASE_URL_PATH:+--server.baseUrlPath=$BASE_URL_PATH} \
  --browser.gatherUsageStats=false"]
