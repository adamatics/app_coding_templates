"""Runtime configuration (CHASSIS, framework-free — imports streamlit NOWHERE).

Stamped identity is injected once by Copier; deployment values come from the environment.
Per Addendum B §B6 every course app shares one AdaLab Shared Volume mounted at ``DATA_DIR``
and owns a per-app subdirectory under it, so a KUID's history across apps stays reachable.
"""
from __future__ import annotations

import os
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

DEFAULT_PORT = 8000
# The shared ASV mount (Addendum A/B). Each app owns a subdirectory under it.
DEFAULT_DATA_DIR = "/asv-mnt/lab-data"

INSTITUTION_NAMES = {
    "SDU": "University of Southern Denmark (SDU)",
    "UCPH": "University of Copenhagen (UCPH)",
    "CPDSE": "Center for Pharmaceutical Data Science Education (CPDSE)",
}


def _env_bool(name: str, default: bool = False) -> bool:
    raw = os.environ.get(name)
    return default if raw is None else raw.strip().lower() in {"1", "true", "yes", "on"}


@dataclass(frozen=True)
class Settings:
    # --- stamped identity (Copier), env-overridable -------------------------
    project_name: str = os.environ.get("PROJECT_NAME", {{ project_name | tojson }})
    project_slug: str = os.environ.get("PROJECT_SLUG", {{ project_slug | tojson }})
    exercise_title: str = os.environ.get("EXERCISE_TITLE", {{ exercise_title | tojson }})
    course_code: str = os.environ.get("COURSE_CODE", {{ course_code | tojson }})
    host_institution: str = os.environ.get("HOST_INSTITUTION", {{ host_institution | tojson }})
    contact_email: str = os.environ.get("CONTACT_EMAIL", {{ contact_email | tojson }})
    default_year: str = os.environ.get("DEFAULT_COHORT_LABEL", {{ default_cohort_label | tojson }})
    app_description: str = os.environ.get("APP_DESCRIPTION", {{ app_description | tojson }})

    # --- deployment env -----------------------------------------------------
    data_dir: Path = field(default_factory=lambda: Path(os.environ.get("DATA_DIR", DEFAULT_DATA_DIR)))
    # Course gate (Addendum B §B2): rotated per semester at deploy time.
    course_id: str = field(default_factory=lambda: os.environ.get("COURSE_ID", os.environ.get("COURSE_CODE", {{ course_code | tojson }})))
    course_password: str | None = os.environ.get("COURSE_PASSWORD") or None
    admin_password: str | None = os.environ.get("ADMIN_PASSWORD") or None
    demo_mode: bool = field(default_factory=lambda: _env_bool("DEMO_MODE", False))
    app_port: int = field(default_factory=lambda: int(os.environ.get("APP_PORT", str(DEFAULT_PORT))))
    # How long a browser session survives (so a refresh — or coming back weeks later to write
    # the report — doesn't mean re-entering the course password and KUID). No student
    # passwords are involved; see core/sessions.py.
    session_ttl_days: int = field(
        default_factory=lambda: max(1, int(os.environ.get("SESSION_TTL_DAYS", "30")))
    )
    # Set at import when no volume is mounted AND no course password is configured:
    # the app runs on scratch space so AdaLab's Test step can start it. Never true
    # for a deployment that can actually collect data. See _resolve_storage below.
    preview_mode: bool = False
    # Set with preview_mode when a course password IS configured: the app starts and serves,
    # but refuses to admit anyone, because a submission would be written to storage that is
    # about to disappear. See _resolve_storage below.
    storage_blocked: bool = False
    # DATA_DIR as configured, kept because _resolve_storage may redirect data_dir to scratch
    # space — and the path the deployer actually needs to fix is the configured one.
    configured_data_dir: Path | None = None
    # "volume" (default) requires a mounted AdaLab Shared Volume and refuses to start
    # without one. "local" writes to DATA_DIR as an ordinary directory, creating it if
    # needed — for running on a laptop or in a lab, or for a short trial where nobody has
    # set up a volume yet. It is opt-in because container-local data is erased by every
    # redeploy; the app says so on every screen and the admin page pushes you to export.
    storage_mode: str = field(
        default_factory=lambda: os.environ.get("STORAGE_MODE", "volume").strip().lower()
    )
    # Streamlit --server.baseUrlPath. Empty by default: the app serves at the container root
    # and AdaLab strips the /apps/<app_url> prefix before forwarding. Set this (and flip
    # stripped_prefix to false) only if your platform forwards the prefix intact.
    base_url_path: str = field(default_factory=lambda: os.environ.get("BASE_URL_PATH", ""))

    @property
    def institution_name(self) -> str:
        return INSTITUTION_NAMES.get(self.host_institution, self.host_institution)

    @property
    def app_data_dir(self) -> Path:
        """This app's per-app subdirectory of the shared ASV (§B6)."""
        return self.data_dir / self.project_slug

    @property
    def db_path(self) -> Path:
        return self.app_data_dir / "results.sqlite"

    @property
    def csv_path(self) -> Path:
        """Long-format CSV mirror, rewritten on every submission (§B6)."""
        return self.app_data_dir / "results.csv"

    @property
    def exports_dir(self) -> Path:
        return self.app_data_dir / "exports"

    @property
    def admin_enabled(self) -> bool:
        return bool(self.admin_password)

    @property
    def gate_enabled(self) -> bool:
        """The course gate can admit students only when a course password is configured."""
        return bool(self.course_password)

    @property
    def local_storage(self) -> bool:
        """Writing to an ordinary directory instead of a mounted Shared Volume (STORAGE_MODE)."""
        return self.storage_mode == "local"

    @property
    def storage_is_durable(self) -> bool:
        """Whether data written here survives a redeploy.

        Only a mounted Shared Volume does. Local mode keeps data until the container is
        replaced; preview mode keeps it until the process stops. Both warn on every screen,
        and neither should be used for a cohort whose results matter without an export plan.
        """
        return not (self.local_storage or self.preview_mode)


settings = Settings()


# --- running without a volume, safely ----------------------------------------
# AdaLab's Test step starts the container with no volume mounts, purely to check that the app
# serves. A hard "no volume, no start" rule makes Test impossible, and Test -> Build -> Deploy
# is the required order.
#
# The safety property was never "a volume must always be mounted" — it is "student data must
# never land on disposable storage". That is enforced by admitting nobody rather than by
# refusing to boot:
#
#   volume present                  ->  normal
#   no volume, STORAGE_MODE=local   ->  deliberate; ordinary disk, loud warnings everywhere
#   no volume, no COURSE_PASSWORD   ->  preview: usable for looking around, nothing collectable
#   no volume, COURSE_PASSWORD set  ->  BLOCKED: starts, serves, admits nobody
#
# The last line used to be "refuse to start", keyed on the password being unset as a proxy for
# "this is Test". That proxy broke when the passwords were declared in
# .adalab/local_container_1.json: Test then supplies one, the guard fired, and the container
# exited with CONTAINER_READINESS_FAILED. Blocking holds the same guarantee without depending
# on how the deploy config happens to be filled in.
def _storage_is_usable(path: Path) -> bool:
    try:
        if not path.is_dir():
            return False
        # Unique per app and process: several course apps share one volume, so a fixed
        # probe name means two containers starting at once delete each other's probe and
        # one wrongly concludes the volume is unwritable (and refuses to start).
        probe = path / f".write-probe-{settings.project_slug}-{os.getpid()}"
        probe.write_text("ok", encoding="utf-8")
        probe.unlink(missing_ok=True)
        return True
    except OSError:
        return False


def _resolve_storage() -> None:
    """Decide where this process writes, and whether it may collect anything at all.

    Three outcomes, and the third one is the interesting one:

    * **The volume is there** — normal. Nothing to do.
    * **No volume, ``STORAGE_MODE=local``** — deliberate. Create the directory and run.
    * **No volume, storage expected** — the app runs on scratch space but is *blocked*: it
      starts, serves, and refuses to let anybody sign in.

    The blocked state replaces an earlier design that refused to start unless
    ``COURSE_PASSWORD`` was unset. That used "no password" as a proxy for "this is the
    extension's Test step, so nothing can be collected" — and the proxy broke the moment the
    passwords were declared in ``.adalab/local_container_1.json``, because Test then supplies
    one and the container exits with ``CONTAINER_READINESS_FAILED``.

    Blocking is a better guarantee than refusing to boot, not a weaker one. What actually
    matters is that **no result is ever written to storage that is about to vanish**; a
    process that starts but admits nobody satisfies that by construction, whatever env it was
    handed. It also means Test can always start the container, and a deployer who forgets the
    volume sees the reason in the browser rather than a crash-looping container with the
    explanation buried in a log.
    """
    configured = settings.data_dir
    if settings.local_storage:
        # Opt-in local disk: DATA_DIR is an ordinary directory, so create it rather than
        # treating "missing" as "the volume was forgotten". If it cannot be created, fall
        # through and let preflight fail loud — silently writing somewhere else is the one
        # outcome this app never allows.
        try:
            configured.mkdir(parents=True, exist_ok=True)
        except OSError:              # pragma: no cover - unwritable parent
            pass
        return
    if _storage_is_usable(configured):
        return                       # normal case: the volume is there

    preview_dir = Path(tempfile.gettempdir()) / f"{settings.project_slug}-preview"
    try:
        preview_dir.mkdir(parents=True, exist_ok=True)
    except OSError:                  # pragma: no cover - nothing writable at all
        return
    object.__setattr__(settings, "configured_data_dir", configured)
    object.__setattr__(settings, "data_dir", preview_dir)
    object.__setattr__(settings, "preview_mode", True)
    # A course password means someone could sign in and submit. With no durable storage
    # underneath, that submission would be lost — so the app admits nobody until the volume
    # is there. Without a password nothing can be collected anyway, so the app stays usable
    # for looking around, which is what the Test step and a local preview want.
    object.__setattr__(settings, "storage_blocked", settings.gate_enabled)


_resolve_storage()
